https://menglan.world/*.webp
  Cache-Control: public, max-age=31536000, immutable

https://menglan.world/*.png
  Cache-Control: public, max-age=31536000, immutable

https://menglan.world/*.ktx2
  Cache-Control: public, max-age=31536000, immutable

https://menglan.world/*.glb
  Cache-Control: public, max-age=31536000, immutable

https://menglan.world/*.mp3
  Cache-Control: public, max-age=31536000, immutable

https://menglan.world/fonts/*
